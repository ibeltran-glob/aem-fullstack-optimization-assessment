/0001 { /type "deny"  /url "*" }
/0002 { /type "deny" /url "/content*" /suffix "*" }
/0003 { /type "deny" /url "/content*" /selectors "*" }
/0004 { /type "allow" /method "GET" /url "/content/*" }
